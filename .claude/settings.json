{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__ccd_session__start_session",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.github/scripts/session_hooks.py\"; [ ! -f \"$f\" ] || python3 \"$f\" pre-start-session"
          }
        ]
      },
      {
        "matcher": "Bash|Monitor|mcp__terminal__run_in_terminal",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.github/scripts/session_hooks.py\"; [ ! -f \"$f\" ] || python3 \"$f\" pre-download"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.github/scripts/session_hooks.py\"; [ ! -f \"$f\" ] || python3 \"$f\" stop"
          }
        ]
      }
    ]
  }
}
