{
  "name": "@nexus/harness",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "nexus-serve": "lib/serve.js",
    "nexus-cli": "lib/cli.js",
    "nexus-plugin": "lib/plugin-cli.js"
  },
  "imports": {
    "#settings/*": "./lib/settings/*.js"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "cli": "tsx --tsconfig ../../tsconfig.runtime.json src/cli.ts",
    "cli:live": "tsx --tsconfig ../../tsconfig.runtime.json src/cli.ts --live",
    "eval:citation": "tsx --tsconfig ../../tsconfig.runtime.json src/eval/citation/citation-cli.ts",
    "eval:compare": "tsx --tsconfig ../../tsconfig.runtime.json src/eval/compare-cli.ts",
    "eval:sessions": "tsx --tsconfig ../../tsconfig.runtime.json src/eval/sessions-cli.ts",
    "eval:survey": "tsx --tsconfig ../../tsconfig.runtime.json src/eval/survey-cli.ts",
    "gen-known-event-types": "tsx --tsconfig ../../tsconfig.runtime.json src/gen-known-event-types.ts",
    "gen-persistence-schema": "tsx --tsconfig ../../tsconfig.runtime.json src/gen-persistence-schema.ts",
    "lint": "eslint .",
    "persistence-changes": "tsx --tsconfig ../../tsconfig.runtime.json src/persistence-changes.ts",
    "plugin": "tsx --tsconfig ../../tsconfig.runtime.json src/plugin-cli.ts",
    "serve": "tsx --tsconfig ../../tsconfig.runtime.json src/serve.ts",
    "serve:live": "tsx --tsconfig ../../tsconfig.runtime.json src/serve.ts --live",
    "smoke": "vitest run --config vitest.smoke.config.ts",
    "spike": "tsx --tsconfig ../../tsconfig.runtime.json src/spike/cli.ts",
    "spike:live": "tsx --tsconfig ../../tsconfig.runtime.json src/spike/cli.ts --live",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify-package-invariants": "tsx --tsconfig ../../tsconfig.runtime.json src/verify-package-invariants.ts",
    "verify-persistence-changes": "tsx --tsconfig ../../tsconfig.runtime.json src/persistence-changes.ts --check",
    "gen-tool-catalog": "tsx --tsconfig ../../tsconfig.runtime.json src/gen-tool-catalog.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@types/compression": "^1.8.1",
    "@types/js-yaml": "^4.0.9",
    "@types/negotiator": "^0.6.5",
    "@types/node": "^24.10.0",
    "@types/semver": "^7.8.0",
    "@types/ws": "^8.18.1",
    "ajv": "8.20.0",
    "eslint": "^9.39.0",
    "js-yaml": "^4.1.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@deepseek-ai/node-addon-system": "0.1.2",
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.13",
    "@langchain/langgraph-checkpoint": "^1.1.5",
    "@langchain/langgraph-sdk": "^1.9.23",
    "@langchain/openai": "^1.5.10",
    "@nexus/agent-loop": "workspace:*",
    "@nexus/approval-channel": "workspace:*",
    "@nexus/commands": "workspace:*",
    "@nexus/cordis": "workspace:*",
    "@nexus/cordis-plugin-include": "workspace:*",
    "@nexus/cordis-plugin-loader": "workspace:*",
    "@nexus/cordis-plugin-logger-console": "workspace:*",
    "@nexus/core": "workspace:*",
    "@nexus/deque": "workspace:*",
    "@nexus/feedback": "workspace:*",
    "@nexus/fs": "workspace:*",
    "@nexus/goal": "workspace:*",
    "@nexus/permission-presets": "workspace:*",
    "@nexus/plugin-agent-instructions": "workspace:*",
    "@nexus/plugin-ask-user": "workspace:*",
    "@nexus/plugin-commands": "workspace:*",
    "@nexus/plugin-echo": "workspace:*",
    "@nexus/plugin-feedback": "workspace:*",
    "@nexus/plugin-goal": "workspace:*",
    "@nexus/plugin-mcp": "workspace:*",
    "@nexus/plugin-memory": "workspace:*",
    "@nexus/plugin-permission-presets": "workspace:*",
    "@nexus/plugin-plan-mode": "workspace:*",
    "@nexus/plugin-present": "workspace:*",
    "@nexus/plugin-quickjs": "workspace:*",
    "@nexus/plugin-sandbox-policy": "workspace:*",
    "@nexus/plugin-skills": "workspace:*",
    "@nexus/plugin-submit-record": "workspace:*",
    "@nexus/plugin-system-prompt": "workspace:*",
    "@nexus/plugin-telemetry-otel": "workspace:*",
    "@nexus/plugin-time-context": "workspace:*",
    "@nexus/plugin-todo": "workspace:*",
    "@nexus/plugin-token-meter": "workspace:*",
    "@nexus/plugin-trajectory": "workspace:*",
    "@nexus/plugin-workspace-changes": "workspace:*",
    "@nexus/projections": "workspace:*",
    "@nexus/sdk": "workspace:*",
    "@nexus/session": "workspace:*",
    "@nexus/skills": "workspace:*",
    "@nexus/system-prompt": "workspace:*",
    "@nexus/timeout": "workspace:*",
    "@nexus/tool-result": "workspace:*",
    "@nexus/tools": "workspace:*",
    "@nexus/web": "workspace:*",
    "@nexus/wire": "workspace:*",
    "@vscode/ripgrep": "^1.18.0",
    "compression": "^1.8.1",
    "deepagents": "~1.13.1",
    "langchain": "^1.5.10",
    "langsmith": ">=0.7.1 <0.10.0",
    "negotiator": "^1.1.0",
    "semver": "^7.8.5",
    "sharp": "0.35.5",
    "ws": "^8.21.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "files": [
    "lib",
    "cordis.yml",
    "cordis.serve.yml"
  ]
}
