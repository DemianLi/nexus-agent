{
  "name": "@nexus/cordis-plugin-include",
  "description": "Include for cordis",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "@nexus/cordis": "workspace:*",
    "@nexus/cordis-plugin-loader": "workspace:*",
    "cosmokit": "^1.8.1",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
