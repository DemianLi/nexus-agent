{
  "name": "@cordisjs/plugin-loader",
  "description": "Loader for cordis",
  "version": "1.0.0-rc.7",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "tsc -p tsconfig.json"
  },
  "license": "MIT",
  "dependencies": {
    "cordis": "workspace:*",
    "cosmokit": "^1.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3"
  }
}
