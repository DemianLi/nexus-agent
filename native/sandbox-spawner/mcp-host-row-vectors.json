{
  "description": "宿主 `mcp/client` 的 `open` 收的 `server` 整份的共用樣本（#3044）：TS 的 mcpHostRow（apps/harness/src/mcp-host-row-service.ts）在工作目錄是 cwd、環境是 parentEnv 時，對 config 與 credentials 的產出要等於 server；宿主的 Server::parse 讀同一份 server 都要收，欄位的值要對得上。有 relativeCommand 的案例，server 的 command 要等於 server 的 cwd 接上 relativeCommand。憑證值都是假的。",
  "cwd": "/srv/nexus",
  "parentEnv": {
    "PATH": "/usr/bin:/bin",
    "HOME": "/home/nexus",
    "LANG": "C.UTF-8",
    "GITHUB_TOKEN": "FAKE-parent-token-0001",
    "NEXUS_AGENT_HOME": "/srv/nexus/home"
  },
  "cases": [
    {
      "name": "http：只寫網址，其餘都是預設值",
      "config": {
        "serverName": "docs",
        "connection": {
          "transport": "http",
          "url": "http://mcp.corp.test:8080/mcp"
        }
      },
      "credentials": {},
      "server": {
        "serverName": "docs",
        "toolCallTimeoutMs": 60000,
        "livenessTimeoutMs": 15000,
        "failOnStartupError": false,
        "maxInstructionBytes": 32768,
        "reconnect": {
          "enabled": true,
          "initialDelayMs": 500,
          "maxDelayMs": 30000,
          "maxAttempts": 10
        },
        "elicitation": true,
