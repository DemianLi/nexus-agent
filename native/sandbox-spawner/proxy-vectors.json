{
  "description": "代理政策的共用樣本：TS 的 proxyForUrl／isLoopbackHost（packages/nexus-core/src/http-proxy/policy.ts）與宿主的 nexus_host::proxy 跑同一份。proxy 是 null 表示直連。",
  "proxyForUrl": [
    {
      "name": "直連：沒有代理",
      "policy": {
        "noProxy": ""
      },
      "url": "https://mcp.example.com/mcp",
      "proxy": null
    },
    {
      "name": "https 走 httpsProxy",
      "policy": {
        "httpProxy": "http://proxy.corp.test:3128",
        "httpsProxy": "https://secure-proxy.corp.test:8443",
        "noProxy": ""
      },
      "url": "https://mcp.example.com/mcp",
      "proxy": "https://secure-proxy.corp.test:8443"
    },
    {
      "name": "http 走 httpProxy",
      "policy": {
        "httpProxy": "http://proxy.corp.test:3128",
        "httpsProxy": "https://secure-proxy.corp.test:8443",
        "noProxy": ""
      },
      "url": "http://mcp.example.com/mcp",
      "proxy": "http://proxy.corp.test:3128"
    },
    {
      "name": "只有 httpProxy：https 直連",
      "policy": {
        "httpProxy": "http://proxy.corp.test:3128",
        "noProxy": ""
      },
      "url": "https://mcp.example.com/mcp",
      "proxy": null
    },
    {
      "name": "localhost 直連",
      "policy": {
        "httpProxy": "http://proxy.corp.test:3128",
        "httpsProxy": "https://secure-proxy.corp.test:8443",
        "noProxy": ""
      },
      "url": "https://localhost:8443/mcp",
      "proxy": null
    },
    {
      "name": "localhost 子網域直連",
      "policy": {
        "httpProxy": "http://proxy.corp.test:3128",
        "httpsProxy": "https://secure-proxy.corp.test:8443",
        "noProxy": ""
      },
      "url": "https://api.localhost/mcp",
      "proxy": null
    },
    {
      "name": "127.0.0.1 直連",
      "policy": {
        "httpProxy": "http://proxy.corp.test:3128",
        "httpsProxy": "https://secure-proxy.corp.test:8443",
        "noProxy": ""
      },
      "url": "https://127.0.0.1/mcp",
      "proxy": null
    },
    {
      "name": "127 整段直連",
      "policy": {
        "httpProxy": "http://proxy.corp.test:3128",
        "httpsProxy": "https://secure-proxy.corp.test:8443",
        "noProxy": ""
      },
      "url": "https://127.200.3.4/mcp",
      "proxy": null
    },
    {
      "name": "127 開頭的主機名：走代理",
      "policy": {
        "httpProxy": "http://proxy.corp.test:3128",
        "httpsProxy": "https://secure-proxy.corp.test:8443",
        "noProxy": ""
      },
      "url": "https://127.0.0.1.nip.test/mcp",
      "proxy": "https://secure-proxy.corp.test:8443"
    },
    {
      "name": "::1 直連",
      "policy": {
        "httpProxy": "http://proxy.corp.test:3128",
        "httpsProxy": "https://secure-proxy.corp.test:8443",
        "noProxy": ""
      },
      "url": "https://[::1]:9000/mcp",
      "proxy": null
    },
    {
      "name": ":: 直連",
      "policy": {
        "httpProxy": "http://proxy.corp.test:3128",
        "httpsProxy": "https://secure-proxy.corp.test:8443",
