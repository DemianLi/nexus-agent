      "url": "https://mcp.example.com/mcp",
      "proxy": null
    },
    {
      "name": "放行：空白與逗號分隔",
      "policy": {
        "httpProxy": "http://proxy.corp.test:3128",
        "httpsProxy": "https://secure-proxy.corp.test:8443",
