    {
      "name": "放行：埠不同",
      "policy": {
        "httpProxy": "http://proxy.corp.test:3128",
        "httpsProxy": "https://secure-proxy.corp.test:8443",
        "noProxy": "mcp.example.com:8443"
      },
      "url": "https://mcp.example.com/mcp",
      "proxy": "https://secure-proxy.corp.test:8443"
    },
    {
      "name": "放行：明寫的埠",
      "policy": {
        "httpProxy": "http://proxy.corp.test:3128",
        "httpsProxy": "https://secure-proxy.corp.test:8443",
        "noProxy": "mcp.example.com:8443"
      },
      "url": "https://mcp.example.com:8443/mcp",
      "proxy": null
    },
    {
      "name": "放行：http 預設 80",
